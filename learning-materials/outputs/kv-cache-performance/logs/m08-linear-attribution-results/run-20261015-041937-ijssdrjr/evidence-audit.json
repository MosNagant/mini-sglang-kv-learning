  "independent_join_sql": "WITH a AS (SELECT 'CUPTI_ACTIVITY_KIND_RUNTIME' AS api_source,start,end,globalTid,correlationId,nameId FROM CUPTI_ACTIVITY_KIND_RUNTIME),n AS (SELECT n.rowid AS nvid,n.start,n.end,n.globalTid,n.endGlobalTid,COALESCE(n.text,s.value) AS label FROM NVTX_EVENTS n LEFT JOIN StringIds s ON n.textId=s.id)\n        SELECT k.rowid AS kid,k.start AS gpu_start,k.end AS gpu_end,k.globalPid,k.correlationId,\n               k.streamId,k.deviceId,k.gridX,k.gridY,k.gridZ,k.blockX,k.blockY,k.blockZ,\n               s.value AS kernel_name,a.api_source,a.start AS api_start,a.end AS api_end,\n               a.globalTid,a.nameId,n.label,n.start AS nvtx_start,n.end AS nvtx_end\n        FROM CUPTI_ACTIVITY_KIND_KERNEL k\n        JOIN a ON (a.globalTid >> 24)=(k.globalPid >> 24) AND a.correlationId=k.correlationId\n        JOIN n ON n.globalTid=a.globalTid AND n.start<=a.start AND a.end<=n.end\n        JOIN StringIds s ON k.demangledName=s.id\n        WHERE n.label LIKE 'M08_LINEAR_%'\n        ORDER BY k.start,k.end,k.rowid",
  "independent_overlap_sql": "WITH n AS (SELECT n.rowid AS nvid,n.start,n.end,n.globalTid,n.endGlobalTid,COALESCE(n.text,s.value) AS label FROM NVTX_EVENTS n LEFT JOIN StringIds s ON n.textId=s.id) SELECT COUNT(*) FROM n a JOIN n b ON a.nvid<b.nvid AND a.globalTid=b.globalTid AND a.start<b.end AND b.start<a.end WHERE a.label LIKE 'M08_LINEAR_%' AND b.label LIKE 'M08_LINEAR_%'",
